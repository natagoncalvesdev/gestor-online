# Copie para .env.local. Rode supabase/migrations/001_initial.sql no SQL Editor do Supabase.

# Projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
# Obrigatória para cadastro, uploads, usuários internos e webhook
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site, sem barra no final. Em produção, a URL da Netlify.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HMR no `next dev` ao abrir por IP (Tailscale/LAN): só o hostname, separado por vírgula se forem vários.
# Ex.: NEXT_DEV_ALLOWED_ORIGINS=100.123.119.64
NEXT_DEV_ALLOWED_ORIGINS=

# Biblioteca de vídeos no Bunny.net (a do site atual)
NEXT_PUBLIC_BUNNY_LIBRARY_ID=494330

# Mercado Pago — Checkout Pro (PIX e cartão)
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura do webhook. Se vazio, o webhook aceita a chamada e consulta o pagamento na API.
MERCADOPAGO_WEBHOOK_SECRET=
